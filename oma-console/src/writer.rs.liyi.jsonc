  "specs": [
    {
      "item": "Writeln",
      "reviewed": false,
      "intent": "Abstraction for emitting one oma-style, prefix-aligned message to a terminal: implementations wrap `msg` to the terminal width, write it out, and propagate I/O errors.",
      "source_span": [
        5,
        7
      ],
      "tree_path": "trait.Writeln",
      "source_hash": "sha256:0757c642051f6031c58e84f0c250cb63b986bb6301ba576c79fa750bca4bd548",
      "source_anchor": "pub trait Writeln {"
    },
    {
      "item": "Writeln for Writer",
      "reviewed": false,
      "intent": "Implement Writeln for Writer: lay out each message through the writer's Terminal configuration (wrap, then padded prefix plus body per line).",
      "source_span": [
        9,
        18
      ],
      "tree_path": "impl.\"Writeln for Writer\"",
      "source_hash": "sha256:65968ac050300f4aba81383735c4102fcae399b61e8f6a8e89735145a41fc529",
      "source_anchor": "impl Writeln for Writer {"
    },
    {
      "item": "Writeln for Writer::writeln",
      "reviewed": false,
      "intent": "Write `msg` as prefix-aligned wrapped lines: the first line carries the oma-style `prefix`, continuation lines keep the prefix area as blank padding, every line ends with a newline, and the first I/O error aborts the write.",
      "source_span": [
        10,
        17
      ],
      "tree_path": "impl.\"Writeln for Writer\"::fn.writeln",
      "source_hash": "sha256:a9d34650161ee0b9f3f34b08d9c90376e0df4ac6b21068d2cfaf5932658363b3",
      "source_anchor": "    fn writeln(&self, prefix: &str, msg: &str) -> io::Result<()> {"
    },
