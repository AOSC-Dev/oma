    {
      "item": "OmaOperation",
      "reviewed": false,
      "intent": "A complete transaction report: packages to install, packages to remove, disk size delta, autoremovable counts, total download size, and suggested/recommended package name pairs.",
      "source_span": [
        9,
        17
      ],
      "tree_path": "struct.OmaOperation",
      "source_hash": "sha256:b2c5b4fe2db530043a3144568b6030799e0c4956aae4b0d3abbadd3dffeef936",
      "source_anchor": "pub struct OmaOperation {"
    },
    {
      "item": "Display for OmaOperation",
      "reviewed": false,
      "intent": "Render the transaction as an oma-style human-readable summary: one line per action group plus a signed, human-readable size delta.",
      "source_span": [
        19,
        109
      ],
      "tree_path": "impl.\"Display for OmaOperation\"",
      "source_hash": "sha256:a3647ef7b0e886d7b13e539cbe16c22c3fd8a0a0a3895a904b34d9b4bd82ed69",
      "source_anchor": "impl Display for OmaOperation {"
    },
    {
      "item": "Display for OmaOperation::fmt",
      "reviewed": false,
      "intent": "Format the operation summary: group installs by operation kind (upgrades show old and new version; automatic installs are annotated), split removals into Remove/Purge by tag, skip empty groups, and print Size-delta with sign and human bytes; install entries carrying the placeholder Default/Download operation are ruled out as unreachable.",
      "source_span": [
        20,
        108
      ],
      "tree_path": "impl.\"Display for OmaOperation\"::fn.fmt",
      "source_hash": "sha256:502937254291bfb0d34c05c8a94c9c00068dd5758a9aabea189a0986abbab9c9",
      "source_anchor": "    fn fmt(&self, f: &mut std::fmt::Formatter<'_>) -> std::fmt::Result {"
    },
    {
