      "source_anchor": "pub struct MirrorManager {"
    },
    {
      "item": "MirrorManager",
      "reviewed": false,
      "intent": "MirrorManager's API: construction from a sysroot (loading or recreating status.json), mirror listing/set/add/remove/ordering, and persisting status.json plus the apt sources list in deb list or deb822 format.",
