  "version": "0.1",
  "source": "terminal.rs",
  "specs": [
    {
      "item": "gen_prefix",
      "reviewed": false,
      "intent": "Render an oma-style message prefix occupying exactly `prefix_len` terminal columns: left-pad `prefix` to `prefix_len - 1` display columns (unicode-aware width) plus one trailing space. Panics when the prefix is too wide to fit; requires `prefix_len >= 1`.",
      "source_span": [
        6,
        17
      ],
      "tree_path": "fn.gen_prefix",
      "source_hash": "sha256:bec3f0637def476aafc09ed07093f3efc514a2df1747398803338208e6db96a6",
      "source_anchor": "pub fn gen_prefix(prefix: &str, prefix_len: u16) -> String {"
    },
    {
      "item": "wrap_content",
      "reviewed": false,
      "intent": "Wrap `msg` to `max_len - prefix_len` columns (textwrap), returning `(prefix, body)` pairs where only the first line carries `prefix` and every body already ends with a trailing newline. Assumes `max_len >= prefix_len`.",
      "source_span": [
        19,
        32
      ],
      "tree_path": "fn.wrap_content",
      "source_hash": "sha256:61fa9068fc83a01d6a5a56e66ba76fec372afabef2e6848d3acd1abc65087832",
      "source_anchor": "pub fn wrap_content<'a>("
    },
    {
      "item": "Terminal",
      "reviewed": false,
      "intent": "A `console::Term` plus oma's display policy: an optional cap on the usable width (`limit_max_len`, `None` = uncapped) and the number of columns reserved for line prefixes (`prefix_len`).",
      "source_span": [
        36,
        40
      ],
      "tree_path": "struct.Terminal",
      "source_hash": "sha256:b4d91a2193b6f432500633e74211e86c7123504945a96783f60ea8b308ed7a0b",
      "source_anchor": "pub struct Terminal {"
    },
    {
      "item": "Terminal",
      "reviewed": false,
      "intent": "Provide Terminal's inherent API: constructors (stderr by default, or stdout), builder-style setters for term / width cap / prefix width, terminal queries (`is_terminal`, size with (25, 80) fallback), oma-style prefix rendering and wrapping, and raw write access.",
      "source_span": [
        42,
        117
      ],
